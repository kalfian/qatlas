        {
          "key": "SHOP-T1",
          "folder": "Auth",
          "title": "User can log in with email & password",
          "description": "Customer login with valid credentials from the environment.",
          "preconditions": "The QA Bot account is registered and active.",
          "priority": "high",
          "status": "ready",
          "execution": "automated",
          "tags": [
            "smoke",
            "auth"
          ],
          "variables": {
            "email": "qa.bot@tokoku.id"
          },
          "steps": [
            {
              "id": "s1",
              "action": "goto",
              "url": "{{env.BASE_URL}}/login",
              "description": "Open the login page"
            },
            {
              "id": "s2",
              "action": "fill",
              "selector": "label=Email",
              "value": "{{vars.email}}"
            },
            {
              "id": "s3",
              "action": "fill",
              "selector": "label=Password",
              "value": "{{secret.QA_PASSWORD}}"
            },
            {
              "id": "s4",
              "action": "click",
              "selector": "role=button[name='Log in']"
            },
            {
              "id": "s5",
              "action": "expect_url",
              "value": "/account",
              "match": "contains",
              "description": "Redirected to the account page",
              "expected": "URL contains /account"
            },
            {
              "id": "s6",
              "action": "expect_visible",
              "selector": "text=Hi, QA Bot"
            }
          ]
        },
        {
