        {
          "key": "SHOP-T4",
          "folder": "Auth",
          "title": "Log in with SMS OTP",
          "description": "The OTP is sent to a physical phone, so this can't be automated.",
          "preconditions": "The tester's phone is registered with number 0812-0000-1234.",
          "priority": "high",
          "status": "ready",
          "execution": "manual",
          "tags": [
            "auth",
            "otp"
          ],
          "variables": {},
          "steps": [
            {
              "id": "sh",
              "action": "manual",
              "description": "Open {{env.BASE_URL}}/login and choose \"Log in with phone number\"",
              "expected": "The phone number form is shown"
            },
            {
              "id": "si",
              "action": "manual",
              "description": "Enter 0812-0000-1234 and click \"Send OTP\"",
              "expected": "The OTP SMS arrives in under 30 seconds"
            },
            {
              "id": "sj",
              "action": "manual",
              "description": "Enter the 6-digit OTP code from the SMS",
              "expected": "The account page opens and shows the name QA Bot"
            },
            {
              "id": "sk",
              "action": "manual",
              "description": "Wait 5 minutes, then try to log in again with the same OTP",
              "expected": "The message \"OTP code expired\" is shown"
            }
          ]
        },
