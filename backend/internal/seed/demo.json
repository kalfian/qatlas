          "key": "SHOP-T15",
          "folder": "API",
          "title": "GET /products returns a product list",
          "description": "",
          "preconditions": "",
          "priority": "high",
          "status": "ready",
          "execution": "automated",
          "tags": [
            "api",
            "smoke"
          ],
          "variables": {},
          "steps": [
            {
              "id": "s1w",
              "action": "http_request",
              "method": "GET",
