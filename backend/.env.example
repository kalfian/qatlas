# QAtlas backend configuration (placeholders only — never commit real values).
# Load for local dev with:  set -a; . ./.env; set +a

# Postgres (dev compose: deploy/docker-compose.dev.yml → 127.0.0.1:55432)
QATLAS_DATABASE_URL=postgres://qatlas:CHANGE_ME@127.0.0.1:55432/qatlas?sslmode=disable

# HTTP listen address (5432/8080 are taken on the dev host)
QATLAS_HTTP_ADDR=:8090

# Public URL of the app: invite links (<base>/invite/<token>) and the Google
# redirect (<base>/api/v1/auth/google/callback). https:// enables Secure cookies.
# With the Vite dev server in real mode use http://localhost:5173.
QATLAS_BASE_URL=http://localhost:8090

# base64 of 32 random bytes (openssl rand -base64 32). Encrypts environment
# secrets — back it up separately; required by `qatlas server`.
QATLAS_MASTER_KEY=CHANGE_ME_BASE64_32_BYTES

# Artifact storage root and (optional) built SPA directory (web/dist).
QATLAS_DATA_DIR=./data
# QATLAS_WEB_DIR=../web/dist

# Artifact store: configured in Admin → Storage (database). Setting
# QATLAS_STORAGE=local|s3 overrides that (the UI becomes read-only); with s3,
# server/worker/all verify the bucket at start (exists + writable).
# QATLAS_STORAGE=s3
# S3-compatible store (Garage, MinIO, AWS). Endpoint = scheme + host only.
# QATLAS_S3_ENDPOINT=https://garage.example.com
# QATLAS_S3_REGION=garage                # default us-east-1; Garage: s3_region of garage.toml
# QATLAS_S3_BUCKET=qatlas
# QATLAS_S3_ACCESS_KEY=GK…               # Garage WebUI → Keys
# QATLAS_S3_SECRET_KEY=CHANGE_ME
# QATLAS_S3_FORCE_PATH_STYLE=true        # default true (Garage/MinIO); false for AWS virtual-host style
# QATLAS_S3_PREFIX=qatlas                # optional key prefix inside the bucket

# Google sign-in: configure it in Admin → Google sign-in (recommended). Setting
# both here overrides that page (read-only). Allowed domains are optional (comma
# separated, e.g. example.com,corp.io) and apply only with GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ALLOWED_DOMAINS=

# Worker / runner (qatlas worker | all). The runner command is split on whitespace; a
# relative script path is also looked up in parent directories (works from backend/).
WORKER_CONCURRENCY=2
QATLAS_RUNNER_CMD=node runner/dist/main.js
# Max duration of one automated execution of a run (Go duration, 1m..24h).
QATLAS_RUN_TIMEOUT=15m

# Only behind a reverse proxy that overwrites X-Real-IP / X-Forwarded-For.
QATLAS_TRUST_PROXY=false
# debug | info | warn | error
QATLAS_LOG_LEVEL=info
# IANA zone for the daily buckets of /projects/{key}/stats (default: system TZ).
# QATLAS_TZ=Asia/Jakarta

# Bootstrap admin password for `qatlas user create-admin` (optional; prompt otherwise)
# QATLAS_ADMIN_PASSWORD=

# Integration tests (go test ./...)
# QATLAS_TEST_DATABASE_URL=postgres://qatlas:CHANGE_ME@127.0.0.1:55432/qatlas_test?sslmode=disable
# S3 tests start a throwaway Garage container (Docker); or point them at a bucket:
# QATLAS_TEST_S3_ENDPOINT= QATLAS_TEST_S3_REGION= QATLAS_TEST_S3_BUCKET=
# QATLAS_TEST_S3_ACCESS_KEY= QATLAS_TEST_S3_SECRET_KEY= QATLAS_TEST_S3_PREFIX=qatlas-test
