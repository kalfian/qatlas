# QAtlas — docker-compose configuration (placeholders only; never commit the real file).
#
#   cp deploy/.env.example deploy/.env && chmod 600 deploy/.env
#   # fill every CHANGE_ME, then:
#   docker compose -f deploy/docker-compose.yml up -d --build
#
# Compose reads deploy/.env automatically (it sits next to docker-compose.yml);
# use --env-file to point at another file.

# Image tag of qatlas-server / qatlas-worker. `up --build` builds them locally
# under this tag; with images pushed by `make docker IMAGE_PREFIX=…` set the
# prefix (with trailing slash) and use `docker compose pull` instead.
QATLAS_VERSION=local
QATLAS_IMAGE_PREFIX=

# --- Network -----------------------------------------------------------------
# Host port and bind address of the app (container port is always 8090).
# Use 127.0.0.1 when a reverse proxy on the same host terminates TLS.
QATLAS_HTTP_PORT=8090
QATLAS_BIND_ADDR=0.0.0.0

# Public URL users open: invite links and the Google redirect
# (<base>/api/v1/auth/google/callback). https:// enables Secure cookies.
QATLAS_BASE_URL=http://localhost:8090

# --- Secrets -----------------------------------------------------------------
# Postgres password. Use URL-safe characters only (it is embedded in the DSN):
#   openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME

# Encrypts environment secrets (AES-256-GCM). base64 of exactly 32 random bytes:
#   openssl rand -base64 32
# BACK IT UP SEPARATELY (password manager). Losing it makes stored secrets unreadable;
# changing it later does the same.
QATLAS_MASTER_KEY=CHANGE_ME

# --- Storage -----------------------------------------------------------------
# Artifacts (screenshots, videos, run temp dirs). A plain name = Docker named
# volume; an absolute path = bind mount (e.g. a Proxmox mount point such as
# /mnt/qatlas-artifacts). A bind-mounted directory must be owned by uid/gid 1001:
#   chown -R 1001:1001 /mnt/qatlas-artifacts
QATLAS_ARTIFACTS=artifacts

# Where artifact files live: local (the volume above) or s3 (an S3-compatible
# bucket; the volume then only holds run temp dirs). Recommended: leave
# QATLAS_STORAGE empty and configure storage in Admin → Storage (saved in the
# database, secret encrypted with QATLAS_MASTER_KEY, switches without a restart,
# migrates existing files from the UI). Setting QATLAS_STORAGE=local|s3 here
# overrides the UI (read-only there). See "Artifact storage" in deploy/README.md.
QATLAS_STORAGE=
# S3 settings for the env override (QATLAS_STORAGE=s3) and `qatlas artifacts migrate`.
#  - bundled Garage (--profile s3): http://garage:3900, region garage; key and
#    bucket from deploy/garage/init.sh
#  - external Garage, e.g. https://garage.example.com, region = s3_region of its
#    garage.toml (usually garage); access key from the Garage WebUI Keys page
QATLAS_S3_ENDPOINT=
QATLAS_S3_REGION=garage
QATLAS_S3_BUCKET=qatlas
QATLAS_S3_ACCESS_KEY=
QATLAS_S3_SECRET_KEY=
# true = https://host/bucket/key (Garage, MinIO); false = virtual-host style (AWS).
QATLAS_S3_FORCE_PATH_STYLE=true
# Optional key prefix inside the bucket (e.g. qatlas) when the bucket is shared.
QATLAS_S3_PREFIX=

# --- Bundled Garage (only with `--profile s3`) -------------------------------
# RPC secret of the Garage node, required by the garage service: openssl rand -hex 32
GARAGE_RPC_SECRET=
# Optional admin API token (port 3903, e.g. for the Garage WebUI): openssl rand -base64 32
GARAGE_ADMIN_TOKEN=
# Data volume of Garage: a plain name = Docker named volume, an absolute path =
# bind mount (e.g. a Proxmox mount point).
GARAGE_DATA=garage-data

# --- Google sign-in (optional override) ----------------------------------------
# Configure Google sign-in in Admin → Google sign-in (recommended: upload the
# OAuth client JSON there, applied without a restart). Setting GOOGLE_CLIENT_ID
# here overrides it (the admin page becomes read-only); ID and secret together.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only with GOOGLE_CLIENT_ID. Comma separated, e.g. example.com,corp.io (empty =
# any verified Google account that already has a QAtlas user).
GOOGLE_ALLOWED_DOMAINS=

# --- Worker ------------------------------------------------------------------
# Parallel runs per worker. Each Chromium context needs roughly 300-500 MB RAM.
WORKER_CONCURRENCY=2
# Cap for one automated execution of a run (Go duration, 1m..24h).
QATLAS_RUN_TIMEOUT=15m
# /dev/shm for Chromium in the worker container.
WORKER_SHM_SIZE=1gb

# --- Misc ----------------------------------------------------------------------
# true only behind a reverse proxy that sets X-Forwarded-For (its right-most entry is the client IP).
QATLAS_TRUST_PROXY=false
# debug | info | warn | error
QATLAS_LOG_LEVEL=info
# IANA zone for daily stats buckets (empty = container TZ, i.e. UTC).
QATLAS_TZ=

# --- Demo target (only with `--profile demo`) --------------------------------
# Published on 127.0.0.1 only; the worker reaches it as http://demo-target:8099.
DEMO_TARGET_PORT=8099
