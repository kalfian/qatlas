# syntax=docker/dockerfile:1
#
# QAtlas server image: `qatlas server` (API + built SPA). Also used for one-shot
# commands (`migrate up`, `user create-admin`, `seed demo`).
#
#   docker build -f deploy/Dockerfile.server -t qatlas-server:<version> --build-arg VERSION=<version> .
#
# Build context is the repository root (see /.dockerignore).

ARG NODE_VERSION=22.23.3
ARG GO_VERSION=1.27.1
ARG ALPINE_VERSION=3.23

# ---------------------------------------------------------------- web (SPA) --
FROM node:${NODE_VERSION}-alpine AS web
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0 \
    CI=true
WORKDIR /src
# Workspace manifests first so the dependency layer is cached across source edits.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY web/package.json web/
COPY runner/package.json runner/
COPY demo-target/package.json demo-target/
RUN --mount=type=cache,id=qatlas-pnpm-store,target=/pnpm-store \
    corepack pnpm config set store-dir /pnpm-store && \
    corepack pnpm install --frozen-lockfile --filter web
COPY web/ web/
# Real API mode: the SPA talks to the Go backend on the same origin.
ENV VITE_API_MODE=real
RUN corepack pnpm --filter web build

# ------------------------------------------------------------ backend (Go) --
FROM golang:${GO_VERSION}-alpine AS go
WORKDIR /src/backend
COPY backend/go.mod backend/go.sum ./
RUN --mount=type=cache,id=qatlas-gomod,target=/go/pkg/mod \
    go mod download
COPY backend/ ./
ARG VERSION=dev
RUN --mount=type=cache,id=qatlas-gomod,target=/go/pkg/mod \
    --mount=type=cache,id=qatlas-gobuild,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=linux go build -trimpath \
      -ldflags "-s -w -X main.version=${VERSION}" \
      -o /out/qatlas ./cmd/qatlas

# ------------------------------------------------------------------ runtime --
FROM alpine:${ALPINE_VERSION}
ARG VERSION=dev
LABEL org.opencontainers.image.title="qatlas-server" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.source="https://github.com/kalfian/qatlas"
# ca-certificates: Google OIDC / S3; tzdata: QATLAS_TZ. Busybox wget serves the healthcheck.
# uid/gid 1001 matches `pwuser` of the Playwright-based worker image, so both can
# write the shared artifacts volume.
RUN apk add --no-cache ca-certificates tzdata && \
    addgroup -S -g 1001 qatlas && \
    adduser -S -D -H -u 1001 -G qatlas -h /var/lib/qatlas -s /sbin/nologin qatlas && \
    mkdir -p /var/lib/qatlas && chown qatlas:qatlas /var/lib/qatlas
COPY --from=go /out/qatlas /usr/local/bin/qatlas
COPY --from=web /src/web/dist /app/web
ENV QATLAS_HTTP_ADDR=:8090 \
    QATLAS_WEB_DIR=/app/web \
    QATLAS_DATA_DIR=/var/lib/qatlas
WORKDIR /var/lib/qatlas
USER qatlas:qatlas
EXPOSE 8090
VOLUME ["/var/lib/qatlas"]
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD wget -q -O /dev/null http://127.0.0.1:8090/healthz || exit 1
ENTRYPOINT ["/usr/local/bin/qatlas"]
CMD ["server"]
