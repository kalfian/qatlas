# QAtlas — /etc/qatlas/qatlas.env for the systemd units (option B).
# install.sh creates this file on the first run (root:qatlas, mode 0640) with a
# freshly generated QATLAS_MASTER_KEY; fill every CHANGE_ME and re-run install.sh.
#
# Syntax: systemd EnvironmentFile — one KEY=value per line, no `export`, no
# shell expansion. Paths (QATLAS_WEB_DIR, QATLAS_RUNNER_CMD,
# PLAYWRIGHT_BROWSERS_PATH, QATLAS_DATA_DIR) are set by the units; only set
# them here to override.

# Postgres. Debian 12 / Ubuntu 24.04:  apt install postgresql
#   sudo -u postgres createuser -P qatlas && sudo -u postgres createdb -O qatlas qatlas
QATLAS_DATABASE_URL=postgres://qatlas:CHANGE_ME@127.0.0.1:5432/qatlas?sslmode=disable

# Listen address of `qatlas server` / `qatlas all`.
QATLAS_HTTP_ADDR=:8090

# Public URL users open (invite links, Google redirect
# <base>/api/v1/auth/google/callback). https:// enables Secure cookies.
QATLAS_BASE_URL=http://CHANGE_ME:8090

# base64 of 32 random bytes (openssl rand -base64 32). Encrypts environment
# secrets — BACK IT UP SEPARATELY; without it stored secrets cannot be decrypted.
QATLAS_MASTER_KEY=CHANGE_ME

# Google sign-in (optional; enabled only when ID and secret are both set).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ALLOWED_DOMAINS=

# Artifact storage: configure it in Admin → Storage (recommended; saved in the
# database with the S3 secret encrypted, switches server and worker without a
# restart, migrates existing files from the UI). Leave QATLAS_STORAGE unset for
# that. Setting it (local | s3 + QATLAS_S3_*) overrides the UI: then server and
# worker check the bucket at start and refuse to start when it is unusable.
# QATLAS_STORAGE=s3
# Garage example: endpoint https://garage.example.com, region garage (the
# s3_region of garage.toml); key ID (GK…) and secret from the Garage WebUI Keys page.
QATLAS_S3_ENDPOINT=
QATLAS_S3_REGION=garage
QATLAS_S3_BUCKET=qatlas
QATLAS_S3_ACCESS_KEY=
QATLAS_S3_SECRET_KEY=
QATLAS_S3_FORCE_PATH_STYLE=true
QATLAS_S3_PREFIX=

# Worker
WORKER_CONCURRENCY=2
QATLAS_RUN_TIMEOUT=15m

# true only behind a reverse proxy that overwrites X-Real-IP / X-Forwarded-For.
QATLAS_TRUST_PROXY=false
# debug | info | warn | error
QATLAS_LOG_LEVEL=info
# IANA zone for daily stats buckets (empty = system zone).
QATLAS_TZ=
