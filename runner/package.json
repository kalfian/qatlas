{
  "name": "@qatlas/runner",
  "private": true,
  "version": "0.1.0",
  "description": "QAtlas test runner: executes Step DSL test cases with Playwright, speaks NDJSON on stdin/stdout.",
  "type": "module",
  "main": "dist/main.js",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "tsc -p tsconfig.json && node --test --test-concurrency=1 \"test/**/*.test.mjs\"",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "playwright": "1.64.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
